PORT=18301
# 留空即可自动跟随 Nginx 透传的 X-Forwarded-Proto + Host（推荐）
# 仅在无法透传代理头时手动填写公网根地址，例如 https://lib.example.com
PUBLIC_BASE_URL=
FRONTEND_URL=

# DLUFL CAS 配置（参考 hydrooj-oauth-dlufl）
CAS_SERVER_URL=https://cas.dlufl.edu.cn
CAS_LOGIN_PATH=/cas/login
CAS_LOGOUT_PATH=/cas/logout
CAS_VALIDATE_PATH=/cas/proxyValidate
CAS_EMAIL_DOMAIN=student.dlufl.edu.cn
INTRANET_CIDRS=192.168.0.0/16,172.23.48.0/21

# 杭州联创 ICSpace 图书馆预约系统地址
ICSPACE_HOST=https://icspace.dlufl.edu.cn

# 安全密钥（生产环境请务必替换为随机 32+ 字节强密钥）
JWT_SECRET=dlufl-library-jwt-secret-change-in-production-2026
CREDENTIAL_ENCRYPTION_KEY=dlufl-library-aes-key-32-chars-min-2026

# SQLite 数据文件路径
DATABASE_PATH=./data/library.db

# 演练模式（默认 false 对接真实大外 ICSpace；无校园网本地体验时可设为 true）
ICSPACE_MOCK_MODE=false
