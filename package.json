{
  "name": "dlufl-cntd",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/index.js",
    "install:all": "npm --prefix backend install --include=dev && npm --prefix frontend install --include=dev",
    "build:all": "npm --prefix backend run build && npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.14.9",
    "@types/tough-cookie": "^4.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/inquirer": "^9.0.7",
    "axios": "^1.7.3",
    "axios-cookiejar-support": "^5.0.2",
    "cheerio": "1.0.0-rc.12",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.4.5",
    "inquirer": "^10.1.8",
    "tough-cookie": "^4.1.4"
  }
